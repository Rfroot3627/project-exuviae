{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exuviae://contracts/logging/vision_log_line.schema.json",
  "title": "VisionLogLine",
  "type": "object",
  "required": ["ts", "node_id", "snapshot_id", "image_path", "desc"],
  "additionalProperties": true,
  "properties": {
    "ts": { "type": "string", "minLength": 1, "maxLength": 64 },
    "node_id": { "$ref": "#/$defs/NodeId" },
    "snapshot_id": { "$ref": "#/$defs/SnapshotId" },
    "image_path": { "$ref": "#/$defs/ImagePath" },
    "desc": { "type": "string", "minLength": 1, "maxLength": 4096 },

    "model": { "type": "string", "maxLength": 128 },
    "latency_ms": { "type": "integer", "minimum": 0, "maximum": 600000 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "maxLength": 64 },
      "maxItems": 32
    }
  },
  "$defs": {
    "NodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
    },
    "SnapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^s-[0-9]{8}-[0-9]{6}-[0-9a-f]{8}$"
    },
    "ImagePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^data/snapshots/[0-9]{4}-[0-9]{2}-[0-9]{2}/[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}/s-[0-9]{8}-[0-9]{6}-[0-9a-f]{8}\\.jpg$"
    }
  }

}
