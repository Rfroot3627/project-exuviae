{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exuviae.contracts.ssot.patterns.v0.1",
  "title": "Exuviae Contracts SSOT Patterns (v0.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["node_id", "snapshot_id", "image_path"],
  "properties": {
    "node_id": {
      "type": "string",
      "description": "Stable node identifier used across contracts",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
    },
    "snapshot_id": {
      "type": "string",
      "description": "Snapshot identifier generated by hub",
      "pattern": "^s-[0-9]{8}-[0-9]{6}-[0-9a-f]{8}$"
    },
    "image_path": {
      "type": "string",
      "description": "Relative path for persisted snapshot images (must match hub config derived rule)",
      "pattern": "^data/snapshots/[0-9]{4}-[0-9]{2}-[0-9]{2}/[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}/s-[0-9]{8}-[0-9]{6}-[0-9a-f]{8}\\.jpg$"
    }
  }
}
