{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exuviae://contracts/capabilities/node_register.schema.json",
  "title": "NodeRegister",
  "type": "object",
  "required": ["node_id", "kind", "firmware", "capabilities"],
  "additionalProperties": true,
  "properties": {
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "firmware": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "capabilities": {
      "type": "object",
      "required": ["video_in"],
      "additionalProperties": true,
      "properties": {
        "video_in": {
          "type": "object",
          "required": ["modes", "formats", "resolutions", "fps_max"],
          "additionalProperties": true,
          "properties": {
            "modes": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "enum": ["snapshot"] }
            },
            "formats": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "enum": ["jpeg"] }
            },
            "resolutions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[0-9]{2,5}x[0-9]{2,5}$"
              }
            },
            "fps_max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          }
        }
      }
    }
  }
}
