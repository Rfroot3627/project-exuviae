{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exuviae.node.node_config.v0.1",
  "title": "Exuviae Node Config (v0.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["node_id", "hub", "features"],
  "properties": {
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
    },
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url", "ws_url"],
      "properties": {
        "base_url": { "type": "string", "minLength": 1, "maxLength": 256 },
        "ws_url": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["camera"],
      "properties": {
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "format": { "type": "string", "enum": ["jpeg"] },
            "resolution": { "type": "string", "enum": ["640x480"] },
            "fps": { "type": "integer", "enum": [1] }
          }
        }
      }
    }
  }
}
